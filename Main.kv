#:import FadeTransition kivy.uix.screenmanager.FadeTransition

# Reusable widgets, styled to match how the KivyMD 1.x widgets looked
<Login,Main,SIGNUP,solvescreen,linearscreen,graphscreen>: # 1.x painted the window background, 2.x screens are see-through
	md_bg_color: self.theme_cls.backgroundColor

<MDIconButton>: # 1.x icon buttons used the text colour, 2.x defaults to the primary colour
	theme_icon_color: "Custom"
	icon_color: "white"

<OrangeButton@MDButton>: # replaces the orange MDFlatButton
	text: ""
	font_size: "14sp"
	style: "filled"
	theme_bg_color: "Custom"
	md_bg_color: "#FF5623"
	MDButtonText:
		text: root.text
		theme_text_color: "Custom"
		text_color: "white"
		theme_font_size: "Custom"
		font_size: root.font_size
		pos_hint: {"center_x": .5, "center_y": .5}

<LineTextField@MDTextField>: # replaces the 'line' mode MDTextField (underline only, no background)
	mode: "filled"
	theme_bg_color: "Custom"
	fill_color_normal: 0, 0, 0, 0
	fill_color_focus: 0, 0, 0, 0

<OrangeTopAppBar@MDTopAppBar>: # 1.x top app bars used the primary colour as their background
	theme_bg_color: "Custom"
	md_bg_color: "#FF5722"

<AppBarTitle@MDTopAppBarTitle>:
	theme_text_color: "Custom"
	text_color: "white"

<OneLineListItem@MDListItem>: # replaces the removed OneLineListItem
	text: ""
	theme_bg_color: "Custom"
	md_bg_color: 0, 0, 0, 0
	MDListItemHeadlineText:
		text: root.text

<ThreeLineListItem@MDListItem>: # replaces the removed ThreeLineListItem
	text: ""
	secondary_text: ""
	tertiary_text: ""
	theme_bg_color: "Custom"
	md_bg_color: 0, 0, 0, 0
	MDListItemHeadlineText:
		text: root.text
	MDListItemSupportingText:
		text: root.secondary_text
	MDListItemTertiaryText:
		text: root.tertiary_text

<NavItem>: # an item in the bottom navigation bar
	MDNavigationItemIcon:
		icon: root.icon
	MDNavigationItemLabel:
		text: root.text

<MD3Card>
	padding: 4
	size_hint: None, None
	size: "200dp", "100dp"

	MDRelativeLayout:

		MDIconButton:
			icon: "dots-vertical"
			pos_hint: {"top": 1, "right": 1}

		MDLabel:
			id: label
			text: root.text
			adaptive_size: True
			theme_text_color: "Custom"
			text_color: "grey"
			pos: "12dp", "12dp"
			bold: True

<Login>:
	name: 'login'
	id: login
	Screen:
		MDLabel:
			text: "Welcome"
			theme_font_size: "Custom"
			font_size: "48dp"
			halign: "center"
			theme_text_color: "Custom"
			text_color: "#FF5623"
			pos_hint: {"center_y": .8}
		LineTextField:
			id: username
			font_size: "20dp"
			size_hint_x: .85
			pos_hint: {'center_x':.5, 'center_y': .65}
			on_text: self.text = self.text.replace(" ","")
			write_tab: False
			MDTextFieldHintText:
				text: 'Username'
			MDTextFieldTrailingIcon:
				icon: 'account'
		LineTextField:
			id: password
			password: True
			font_size: "20dp"
			size_hint_x: .85
			pos_hint: {'center_x':.5, 'center_y': .5}
			on_text: self.text = self.text.replace(" ","")
			write_tab: False
			MDTextFieldHintText:
				text: 'Password'
			MDTextFieldTrailingIcon:
				id: password_icon
				icon: 'eye-off'
		BoxLayout:
			size_hint: .85, None
			height: "30dp"
			pos_hint: {'center_x':.5,'center_y':.4}
			spacing: '5dp'
			MDCheckbox:
				id: cb
				size_hint: None, None
				width: '30dp'
				height: '30dp'
				pos_hint: {'center_x':.5, 'center_y': .5}
				on_press:
					password.password = False if password.password == True else True
					password_icon.icon = "eye" if password_icon.icon == "eye-off" else "eye-off"
			MDLabel:
				text: "[ref=Show Password]Show Password[/ref]"
				markup: True
				pos_hint: {'center_x':.5, 'center_y': .5}
				on_ref_press:
					cb.active = False if cb.active == True else True
		BoxLayout:
			size_hint: .6, None
			height: '30dp'
			pos_hint: {'center_x':.5,'center_y':.3}
			spacing: '15dp'
			OrangeButton:
				text: "SIGN IN"
				font_size: "22dp"
				theme_width: "Custom"
				size_hint_x: 1
				on_release:
					root.logger()


			OrangeButton:
				text: "SIGN UP"
				font_size: "22dp"
				theme_width: "Custom"
				size_hint_x: 1
				on_release: root.manager.current = "signup"
		BoxLayout:
			MDLabel:
				pos_hint: {'center_x':.5,'center_y':.2}
				id: attempt
				text : ""
<Main>:
	id:main
	name: 'main'
	MDBoxLayout: # MDBottomNavigation was replaced by a screen manager + MDNavigationBar
		orientation: 'vertical'
		MDScreenManager:
			id: tabs
			transition: FadeTransition(duration=.2)

			MDScreen:
				name: "Home"
				BoxLayout:
					orientation: 'vertical'
					OrangeTopAppBar:
						AppBarTitle:
							text: 'Home'
					GridLayout:
						id: imagegrid
						cols: 1
						spacing: dp(8)
						padding: dp(8)
				MDIconButton:
					height: "30dp"
					pos_hint: {'center_x':.95,'center_y':.95}
					icon: 'information-outline'
					style: 'standard'
					on_release:
						root.display_info()

			MDScreen:
				name: "Camera"
				BoxLayout:
					orientation: 'vertical'

					OpenCVCamera:
						id: camera
						resolution: (640, 480)
						play: True
						index: 1
					BoxLayout:
						size_hint: .6, None
						height: '30dp'
						pos_hint: {'center_x':.5,'center_y':.3}
						spacing: '15dp'
						MDIconButton:
							icon: "camera-flip"
							size_hint_y: None
							size_hint_x: 1
							height: '60dp'
							on_release: root.switch_camera()
						MDIconButton:
							icon: "camera"
							size_hint_y: None
							size_hint_x: 1
							theme_bg_color: "Custom"
							md_bg_color: "#FF5623"
							height: '60dp'
							on_release:
								root.capture()
								root.on_enter()
						MDIconButton:
							icon: "image-filter-none"
							size_hint_y: None
							size_hint_x: 1
							height: '60dp'
							on_release: root.upload_photo()


			MDScreen:
				name: "Account"

				BoxLayout:
					alignment: "center"
					orientation: 'vertical'
					OrangeTopAppBar:
						AppBarTitle:
							id: topbar
							text: "Account"
					ScrollView:

						GridLayout:
							id: accountdetails
							cols: 1
							size_hint_y: None
							height: self.minimum_height


				OrangeButton:
					text: "SIGN OUT"
					pos_hint: {'center_x':.5, 'center_y': .1}
					font_size: "20dp"
					on_press: root.manager.current = "login"

		MDNavigationBar:
			on_switch_tabs: tabs.current = args[3] # args[3] is the text of the item pressed

			NavItem:
				text: "Home"
				icon: "home"
				active: True

			NavItem:
				text: "Camera"
				icon: "camera"

			NavItem:
				text: "Account"
				icon: "account"

<ChangePasswordContent>:
	orientation: 'vertical'
	adaptive_height: True
	halign: "center"
	LineTextField:
		write_tab: False
		id:old_password
		pos_hint: {'center_x':.5}
		size_hint_x: 0.8
		MDTextFieldHintText:
			text: "enter old password"

	LineTextField:
		write_tab: False
		id:new_password
		pos_hint: {'center_x':.5}
		size_hint_x: 0.8
		MDTextFieldHintText:
			text: "enter new password"

	OrangeButton:
		pos_hint: {'center_x':.5}
		#size_hint_x: 0.4
		text: 'Confirm'
		on_release: root.change_password()

<ChangePasswordHeader>: # clickable header row of the change password expansion panel
	MDListItem:
		theme_bg_color: "Custom"
		md_bg_color: 0, 0, 0, 0
		on_release: root.toggle_panel()
		MDListItemHeadlineText:
			text: "Change Password"
		PanelChevron:
			id: chevron
			icon: "chevron-right"


<SIGNUP>:
	name: "signup"
	MDLabel:
		text: "Create Account"
		theme_font_size: "Custom"
		font_size: "48dp"
		halign: "center"
		theme_text_color: "Custom"
		text_color: "#FF5623"
		pos_hint: {"center_y": .8}
	LineTextField:
		id: new_username
		font_size: "20dp"
		size_hint_x: .85
		pos_hint: {'center_x':.5, 'center_y': .6}
		on_text: self.text = self.text.replace(" ","")
		write_tab: False
		MDTextFieldHintText:
			text: 'enter new username'
		MDTextFieldTrailingIcon:
			icon: 'account'
	LineTextField:
		id: password1
		password: True
		font_size: "20dp"
		size_hint_x: .85
		pos_hint: {'center_x':.5, 'center_y': .5}
		on_text: self.text = self.text.replace(" ","")
		write_tab: False
		MDTextFieldHintText:
			text: 'enter new password'
		MDTextFieldTrailingIcon:
			icon: 'eye-off'
	LineTextField:
		id: password2
		password: True
		font_size: "20dp"
		size_hint_x: .85
		pos_hint: {'center_x':.5, 'center_y': .4}
		on_text: self.text = self.text.replace(" ","")
		write_tab: False
		MDTextFieldHintText:
			text: 're-enter new password'
		MDTextFieldTrailingIcon:
			icon: 'eye-off'

	BoxLayout:
		size_hint: .6, None
		height: '30dp'
		pos_hint: {'center_x':.5,'center_y':.3}
		spacing: '10dp'
		OrangeButton:
			text: "CONFIRM"
			font_size: "18dp"
			theme_width: "Custom"
			size_hint_x: 1
			on_release: root.create_account()
		OrangeButton:
			text: "GO BACK"
			font_size: "18dp"
			theme_width: "Custom"
			size_hint_x: 1
			on_release: root.manager.current = "login"


<solvescreen>:
	name: 'solve screen'
	BoxLayout:
		orientation: 'vertical'
		adaptive_height: True
		OrangeTopAppBar:
			AppBarTitle:
				text: "Solution"
		MDIconButton:
			icon: "arrow-left"
			on_release: root.manager.current = "main"
		ScrollView:
			GridLayout:
				pos_hint: {'center_x': 0.5}
				cols: 1
				size_hint_y: None
				MDList:
					OneLineListItem:
						id: equation
					ThreeLineListItem:
						id: line1
					ThreeLineListItem:
						id: line2
					OneLineListItem:
						id: line3
					OneLineListItem:
						id: line4
					OneLineListItem:
						id: line5
<linearscreen>:
	name: 'linear'
	BoxLayout:
		orientation: 'vertical'
		adaptive_height: True
		OrangeTopAppBar:
			AppBarTitle:
				text: "Solution"
		MDIconButton:
			icon: "arrow-left"
			on_release: root.manager.current = "main"
		ScrollView:
			GridLayout:
				pos_hint: {'center_x': 0.5}
				cols: 1
				size_hint_y: None
				MDList:
					OneLineListItem:
						id: method
					OneLineListItem:
						id: result

<graphscreen>:
	name: 'graph'
	BoxLayout:
		orientation: 'vertical'
		adaptive_height: True
		OrangeTopAppBar:
			AppBarTitle:
				text: "Graph Solution"
		MDIconButton:
			icon: "arrow-left"
			on_release:
				root.manager.current = "main"
				root.delete_plot()
		BoxLayout:
			id: graph
		MDLabel:
			pos_hint: {'center_x': 0.5}
			size_hint_y: None
			id: exact
			text: ""
		MDLabel:
			pos_hint: {'center_x': 0.5}
			size_hint_y: None
			id: decimal
			text: ""
		MDLabel:
			pos_hint: {'center_x': 0.5}
			size_hint_y: None
			id: nature
			text: ""
